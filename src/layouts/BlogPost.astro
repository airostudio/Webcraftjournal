---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';

interface Props {
  post: CollectionEntry<'blog'>;
  readingMinutes: number;
}

const { post, readingMinutes } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, tags, coverImage, canonicalUrl } = post.data;

const postUrl = new URL(`/blog/${post.slug}/`, SITE.url).toString();
const ogImage = `/og/${post.slug}.png`;

const isFreshNews =
  Date.now() - pubDate.getTime() < 1000 * 60 * 60 * 24 * 2 && category === 'AI Web Technologies';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isFreshNews ? 'NewsArticle' : 'TechArticle',
  headline: title,
  description,
  image: [new URL(coverImage, SITE.url).toString()],
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', SITE.url).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
  keywords: tags.join(', '),
  articleSection: category,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/blog/', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  image={ogImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  author={author}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
  <article class="container-prose py-12">
    <header class="mb-8 flex flex-col gap-4">
      <a
        href={`/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
        class="text-sm font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400"
      >
        {category}
      </a>
      <h1 class="font-serif text-4xl font-bold leading-tight sm:text-5xl">{title}</h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
      <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-500 dark:text-neutral-500">
        <span>By {author}</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span aria-hidden="true">&middot;</span>
        <span>{readingMinutes} min read</span>
      </div>
      <img
        src={coverImage}
        alt={title}
        width="1200"
        height="630"
        class="mt-2 aspect-[1200/630] w-full rounded-lg object-cover"
      />
    </header>
    <div class="prose prose-neutral max-w-none dark:prose-invert prose-img:rounded-lg">
      <slot />
    </div>
    {tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2 border-t border-neutral-200 pt-6 dark:border-neutral-800">
        {tags.map((tag) => (
          <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
