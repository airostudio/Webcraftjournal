---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORY_LIST } from '@/content/config';

// Injected only for non-Vercel builds (see astro.config.mjs).
export const prerender = false;
---

<BaseLayout
  title="Admin — Publish Article"
  description="Upload a document to publish a new Viewport Index article."
  noindex
>
  <section class="container-prose py-12">
    <h1 class="mb-2 font-serif text-3xl font-bold">Publish an Article</h1>
    <p class="mb-8 text-sm text-neutral-500 dark:text-neutral-400">
      Upload a <code>.docx</code>, <code>.md</code>, or <code>.mdx</code> file and choose a category. The file is
      converted, given a guaranteed editorial backlink, and written to <code>src/content/blog/</code>.
    </p>

    <form id="upload-form" class="flex flex-col gap-5" enctype="multipart/form-data">
      <div>
        <label for="password" class="mb-1 block text-sm font-medium">Admin password</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autocomplete="current-password"
          class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900"
        />
      </div>

      <div>
        <label for="file" class="mb-1 block text-sm font-medium">Document</label>
        <input
          type="file"
          id="file"
          name="file"
          accept=".docx,.md,.mdx"
          required
          class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm file:mr-3 file:rounded file:border-0 file:bg-brand-600 file:px-3 file:py-1.5 file:text-white dark:border-neutral-700 dark:bg-neutral-900"
        />
      </div>

      <div>
        <label for="category" class="mb-1 block text-sm font-medium">Category</label>
        <select
          id="category"
          name="category"
          required
          class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900"
        >
          <option value="" disabled selected>Choose a category&hellip;</option>
          {CATEGORY_LIST.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>

      <div>
        <label for="tags" class="mb-1 block text-sm font-medium">Tags <span class="text-neutral-400">(comma-separated, optional)</span></label>
        <input
          type="text"
          id="tags"
          name="tags"
          placeholder="css, layout, performance"
          class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900"
        />
      </div>

      <div>
        <label for="author" class="mb-1 block text-sm font-medium">Author <span class="text-neutral-400">(optional)</span></label>
        <input
          type="text"
          id="author"
          name="author"
          placeholder="Viewport Index Editorial Team"
          class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm dark:border-neutral-700 dark:bg-neutral-900"
        />
      </div>

      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" id="overwrite" name="overwrite" value="true" />
        Overwrite if a post with this title's slug already exists
      </label>

      <button
        type="submit"
        id="submit-button"
        class="w-fit rounded-md bg-brand-600 px-5 py-2 text-sm font-semibold text-white hover:bg-brand-700 disabled:opacity-50"
      >
        Publish
      </button>

      <p id="status" class="text-sm" role="status" aria-live="polite"></p>
    </form>
  </section>

  <script>
    const form = document.getElementById('upload-form') as HTMLFormElement | null;
    const status = document.getElementById('status') as HTMLParagraphElement | null;
    const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;

    if (form && status && submitButton) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Publishing…';
        status.className = 'text-sm text-neutral-500';
        submitButton.disabled = true;

        try {
          const response = await fetch('/api/admin/upload', {
            method: 'POST',
            body: new FormData(form),
          });
          const data = await response.json();

          if (!response.ok) {
            status.textContent = data.error ?? 'Something went wrong.';
            status.className = 'text-sm text-red-600 dark:text-red-400';
            return;
          }

          status.innerHTML = `Published <strong>${data.title}</strong> in ${data.category}. It will appear at <a class="underline" href="${data.path}">${data.path}</a> once the site rebuilds (or automatically on the dev server).`;
          status.className = 'text-sm text-green-700 dark:text-green-400';
          form.reset();
        } catch {
          status.textContent = 'Network error — is the server running?';
          status.className = 'text-sm text-red-600 dark:text-red-400';
        } finally {
          submitButton.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>
