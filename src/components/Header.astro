---
import { CATEGORY_LIST } from '@/content/config';
---

<header class="border-b border-neutral-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-950/80">
  <div class="container-wide flex flex-col gap-4 py-5">
    <div class="flex items-center justify-between">
      <a href="/" class="font-serif text-2xl font-bold tracking-tight">
        Viewport <span class="text-brand-600 dark:text-brand-400">Index</span>
      </a>
      <a
        href="/rss.xml"
        class="hidden text-sm font-medium text-neutral-500 hover:text-brand-600 sm:inline dark:hover:text-brand-400"
      >
        RSS
      </a>
    </div>
    <nav aria-label="Categories" class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <a href="/blog" class="font-medium text-neutral-700 hover:text-brand-600 dark:text-neutral-300 dark:hover:text-brand-400">
        All Articles
      </a>
      {CATEGORY_LIST.map((category) => (
        <a
          href={`/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
          class="text-neutral-500 hover:text-brand-600 dark:text-neutral-400 dark:hover:text-brand-400"
        >
          {category}
        </a>
      ))}
    </nav>
  </div>
</header>
