---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { CATEGORY_LIST } from '@/content/config';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  return CATEGORY_LIST.map((category) => ({
    params: { category: category.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { category },
  }));
}

const { category } = Astro.props as { category: (typeof CATEGORY_LIST)[number] };

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={`${category} | ${SITE.title}`}
  description={`Articles in ${category} from ${SITE.title}, the journal of web design and frontend engineering.`}
>
  <section class="container-wide py-12">
    <h1 class="mb-8 font-serif text-3xl font-bold">{category}</h1>
    {posts.length === 0 ? (
      <p class="text-neutral-500">No articles published in this category yet.</p>
    ) : (
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    )}
  </section>
</BaseLayout>
