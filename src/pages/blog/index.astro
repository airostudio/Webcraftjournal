---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { SITE } from '@/lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title={`Articles | ${SITE.title}`}
  description="Every article published in Viewport Index: web design, design systems, AI web technologies, performance, and frontend engineering."
>
  <section class="container-wide py-12">
    <h1 class="mb-8 font-serif text-3xl font-bold">All Articles</h1>
    {posts.length === 0 ? (
      <p class="text-neutral-500">No articles published yet — check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
    )}
  </section>
</BaseLayout>
